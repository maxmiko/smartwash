# ============================================================
#  Smart Wash — Apache / cPanel configuration
# ============================================================

# ---- Default charset & language ----------------------------
AddDefaultCharset UTF-8
DefaultLanguage lv

# ---- Directory index & options -----------------------------
DirectoryIndex index.html
Options -Indexes -MultiViews
ServerSignature Off

# ---- Custom error documents --------------------------------
ErrorDocument 404 /404.html

# ============================================================
#  HTTPS + www canonicalisation  (single redirect)
#  -> force https and NON-www (https://smartwash.lv)
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^(.+)$
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Strip www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================================
#  Security headers
# ============================================================
<IfModule mod_headers.c>
  # HSTS — enable only once HTTPS is confirmed working
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Content Security Policy — static site, no JS, self-hosted fonts/images
  Header always set Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"

  # Don't leak the cross-origin font preload as credentialed
  <FilesMatch "\.(woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Remove ETag (we use strong cache + Last-Modified)
  Header unset ETag
</IfModule>
FileETag None

# ============================================================
#  Compression
# ============================================================
# Prefer pre-built Brotli/Gzip if present (mod_brotli/mod_deflate negotiation)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    application/rss+xml image/svg+xml application/manifest+json \
    application/ld+json font/ttf font/otf
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript \
    application/json application/xml image/svg+xml application/manifest+json \
    application/ld+json
</IfModule>

# ============================================================
#  Caching
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — always revalidate
  ExpiresByType text/html "access plus 0 seconds"

  # Versionable static assets — 1 year, immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # HTML: revalidate every request
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Immutable assets
  <FilesMatch "\.(css|js|avif|webp|jpg|jpeg|png|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ============================================================
#  Correct MIME types (in case host is missing them)
# ============================================================
<IfModule mod_mime.c>
  AddType image/avif                 .avif
  AddType image/webp                 .webp
  AddType image/svg+xml              .svg
  AddType font/woff2                 .woff2
  AddType application/manifest+json  .webmanifest
  AddType application/ld+json        .jsonld
</IfModule>

# ============================================================
#  Protect sensitive files
# ============================================================
<FilesMatch "(^\.|\.(bak|config|sql|ini|log|sh|inc|md)$)">
  Require all denied
</FilesMatch>
